+def _partir_serie_por_kg(etiquetas: list[dict]) -> tuple[list[dict], list[dict]]:
+    """K2: parte una lista de etiquetas de una SERIE (orden de prioridad, sin
+    reordenar) en 2 bloques CONTIGUOS lo mas parejos posible por kg acumulado
+    (~50/50) para el reparto en paralelo. Bloque A = prefijo, Bloque B =
+    resto. Con < 2 etiquetas o kg total 0, retorna (etiquetas, []) — sin
+    reparto posible."""
+    if len(etiquetas) < 2:
+        return list(etiquetas), []
+    kg_total = sum(e.get("kgs", 0) for e in etiquetas)
+    if kg_total <= 0:
+        mid = len(etiquetas) // 2 or 1
+        return etiquetas[:mid], etiquetas[mid:]
+    objetivo = kg_total / 2.0
+    acumulado = 0.0
+    corte = 1
+    for i, e in enumerate(etiquetas):
+        acumulado += e.get("kgs", 0)
+        if acumulado >= objetivo:
+            corte = i + 1
+            break
+    corte = max(1, min(corte, len(etiquetas) - 1))
+    return etiquetas[:corte], etiquetas[corte:]
+
