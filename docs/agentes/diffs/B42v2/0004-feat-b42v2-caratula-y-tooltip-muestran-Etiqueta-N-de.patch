                             </div>
                             <div className="flex justify-between items-center">
-                                <span className="text-slate-500 w-20 shrink-0">TAGs:</span>
-                                <span className="font-semibold text-slate-200">{hoveredEvent.nr_tags ?? 1} etiquetas</span>
+                                <span className="text-slate-500 w-20 shrink-0">Peso:</span>
+                                <span className="font-semibold text-slate-200">{Math.round(hoveredEvent.kilos ?? 0).toLocaleString('es-CL')} kg</span>
                             </div>
                             <div className="flex justify-between items-center pt-1 border-t border-slate-800/50">
                                 <span className="text-slate-500 w-20 shrink-0">Operador:</span>
