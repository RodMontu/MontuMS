+"""
+Pruebas de universo_fechas.clasificar_fecha — un caso por categoría, más el
+caso límite de "muy futura por horizonte" (sección 3 del spec).
+
+Ejecutar: python -m unittest test_universo_fechas -v
+"""
+import unittest
+from datetime import date, timedelta
+
+import universo_fechas as uf
+
+HOY = date(2026, 9, 24)
+
+
+class TestClasificarFecha(unittest.TestCase):
+
+    def test_atrasada_valida_1_a_30_dias(self):
+        fecha = HOY - timedelta(days=15)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "atrasada_valida")
+
+    def test_atrasada_valida_limite_30_dias(self):
+        fecha = HOY - timedelta(days=30)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "atrasada_valida")
+
+    def test_atrasada_suciedad_mas_de_30_dias(self):
+        fecha = HOY - timedelta(days=31)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "atrasada_suciedad")
+
+    def test_proxima_hoy(self):
+        self.assertEqual(uf.clasificar_fecha(HOY, hoy=HOY), "proxima")
+
+    def test_proxima_limite_21_dias(self):
+        fecha = HOY + timedelta(days=21)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "proxima")
+
+    def test_lejana_normal_22_a_60_dias(self):
+        fecha = HOY + timedelta(days=45)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "lejana_normal")
+
+    def test_lejana_normal_limite_60_dias(self):
+        fecha = HOY + timedelta(days=60)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "lejana_normal")
+
+    def test_muy_futura_mas_de_60_dias(self):
+        fecha = HOY + timedelta(days=61)
+        self.assertEqual(uf.clasificar_fecha(fecha, hoy=HOY), "muy_futura")
+
+    def test_muy_futura_por_horizonte_sospechoso(self):
+        # Caso sintético (el ejemplo del spec, IT 1384 de Cerrillos, es un mal
+        # ejemplo para esta regla: +98d ya supera +60d por el umbral simple).
+        # Aquí: +45d cae en lejana_normal por umbral simple, pero un horizonte
+        # de reprogramación de 150d (>120) la reclasifica a muy_futura.
+        fecha = HOY + timedelta(days=45)
+        self.assertEqual(
+            uf.clasificar_fecha(fecha, horizonte_reprog=150, hoy=HOY),
+            "muy_futura",
+        )
+
+    def test_horizonte_sospechoso_no_reclasifica_proxima(self):
+        # La regla de horizonte nunca debe sacar algo de "proxima" (dias<=21),
+        # aunque el horizonte sea sospechoso.
+        fecha = HOY + timedelta(days=10)
+        self.assertEqual(
+            uf.clasificar_fecha(fecha, horizonte_reprog=500, hoy=HOY),
+            "proxima",
+        )
+
+    def test_horizonte_none_no_afecta_clasificacion(self):
+        fecha = HOY + timedelta(days=45)
+        self.assertEqual(
+            uf.clasificar_fecha(fecha, horizonte_reprog=None, hoy=HOY),
+            "lejana_normal",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
