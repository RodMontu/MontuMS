+class AjusteDuracionRequest(BaseModel):
+    sucursal_id: int
+    turno: str
+    fecha: str
+    id_tarea: str
+    minutos: int
+    usuario: str = "desconocido"
+
+
+@router.post("/ajuste-duracion")
+def guardar_ajuste_duracion(payload: AjusteDuracionRequest):
+    """
+    B44(a): "Ajustar duracion del trabajo (en minutos)" del modal de detalle.
+    Fuera de alcance (ver ticket): auto-aprendizaje / retroalimentar al Motor
+    / cambiar estimar_duracion_min o la asignacion — esto SOLO cambia el fin
+    mostrado de la cajita ajustada. Persistencia en ajustes_duracion; efecto
+    inmediato se logra tambien actualizando global_eventos en memoria aqui
+    mismo, sin esperar el proximo GET/Generar.
+    """
+    if payload.minutos <= 0:
+        raise HTTPException(status_code=400, detail="minutos debe ser mayor a 0")
+
+    turno_norm = payload.turno.lower().replace("í", "i").replace("ó", "o")
+    try:
+        _init_programacion_guardada()
+        with sqlite3.connect(DB_PATH, timeout=10) as conn:
+            conn.execute(
+                """
+                INSERT INTO ajustes_duracion (sucursal_id, fecha, turno, id_tarea, minutos, usuario, creado_en)
+                VALUES (?, ?, ?, ?, ?, ?, datetime('now'))
+                ON CONFLICT (sucursal_id, fecha, turno, id_tarea)
+                DO UPDATE SET minutos=excluded.minutos, usuario=excluded.usuario, creado_en=excluded.creado_en
+                """,
+                (payload.sucursal_id, payload.fecha, turno_norm, payload.id_tarea, payload.minutos, payload.usuario),
+            )
+    except Exception as e:
+        logger.error(f"[B44a] No se pudo guardar ajuste de duracion: {e}")
+        raise HTTPException(status_code=500, detail="No se pudo guardar el ajuste")
+
+    # Efecto inmediato en memoria (sin esperar el próximo Generar/reload).
+    fecha_fin_nueva = None
+    for ev in global_eventos:
+        if (
+            ev.get("id_tarea") == payload.id_tarea
+            and str(ev.get("sucursal_id")) == str(payload.sucursal_id)
+            and str(ev.get("turno", "")).lower().replace("í", "i").replace("ó", "o") == turno_norm
+            and str(ev.get("fecha", "")) == str(payload.fecha)
+            and ev.get("fecha_inicio")
+        ):
+            inicio = datetime.fromisoformat(ev["fecha_inicio"])
+            fecha_fin_nueva = (inicio + timedelta(minutes=payload.minutos)).isoformat()
+            ev["fecha_fin"] = fecha_fin_nueva
+            ev["duracion_min"] = payload.minutos
+            ev["ajuste_manual"] = True
+
+    return {"status": "ok", "id_tarea": payload.id_tarea, "minutos": payload.minutos, "fecha_fin": fecha_fin_nueva}
+
+
 class AplicarRepartoRequest(BaseModel):
