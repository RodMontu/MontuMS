+import { useState, useEffect, useCallback } from 'react';
+import { RefreshCw, CheckCircle2, AlertTriangle } from 'lucide-react';
+
+interface FuenteEstado {
+    fuente: 'universo' | 'cuadro';
+    sucursal_id: number;
+    minutos_desde_ok: number | null;
+    desactualizado: boolean;
+    ultimo_error_msg: string | null;
+}
+
+interface SyncEstadoResponse {
+    sincronizando: boolean;
+    fuentes: FuenteEstado[];
+}
+
+const NOMBRE_FUENTE: Record<string, string> = { universo: 'Universo', cuadro: 'Cuadro' };
+
+function formatearAntiguedad(minutos: number | null): string {
+    if (minutos === null) return 'sin datos';
+    if (minutos < 60) return `hace ${Math.round(minutos)} min`;
+    return `hace ${Math.round(minutos / 60)} h`;
+}
+
+/**
+ * Botón "Sincronizar" unificado (universo + Cuadro OptiSteel) con badge de
+ * estado por fuente. Integración pendiente en GestorProgramacion.tsx (ver
+ * informe CCa17): reemplaza el botón "Sincronizar" actual, que hoy solo
+ * hace fetchData() sin refrescar ninguna fuente de datos real.
+ */
+export default function SyncEstado({ sucursal, onSynced }: { sucursal: number | string; onSynced?: () => void }) {
+    const [estado, setEstado] = useState<SyncEstadoResponse | null>(null);
+    const [sincronizando, setSincronizando] = useState(false);
+    const [error, setError] = useState<string | null>(null);
+
+    const cargarEstado = useCallback(() => {
+        fetch('/api/sync/estado')
+            .then(r => r.json())
+            .then((data: SyncEstadoResponse) => setEstado(data))
+            .catch(() => {});
+    }, []);
+
+    useEffect(() => {
+        cargarEstado();
+        const interval = setInterval(cargarEstado, 60000);
+        return () => clearInterval(interval);
+    }, [cargarEstado]);
+
+    const handleSincronizar = async () => {
+        setSincronizando(true);
+        setError(null);
+        try {
+            const resp = await fetch('/api/sync/ejecutar', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ sucursal_id: Number(sucursal) }),
+            });
+            const data = await resp.json();
+            if (!resp.ok) {
+                setError(data.detail || 'Error al sincronizar');
+            } else if (!data.ok) {
+                const fallidas = (data.resultados || []).filter((r: { ok: boolean }) => !r.ok);
+                setError(fallidas.length ? `Falló: ${fallidas.map((f: { fuente: string }) => NOMBRE_FUENTE[f.fuente] || f.fuente).join(', ')}` : 'Sincronización incompleta');
+            }
+            onSynced?.();
+        } catch (e) {
+            setError('No se pudo conectar con el servidor');
+        } finally {
+            setSincronizando(false);
+            cargarEstado();
+        }
+    };
+
+    const fuentesSucursal = (estado?.fuentes || []).filter(f => f.sucursal_id === Number(sucursal));
+
+    return (
+        <div className="flex items-center gap-2">
+            <button
+                onClick={handleSincronizar}
+                disabled={sincronizando || estado?.sincronizando}
+                title={error || undefined}
+                className="btn-secondary text-sm"
+            >
+                <RefreshCw className={`w-4 h-4 ${sincronizando || estado?.sincronizando ? 'animate-spin' : ''}`} /> Sincronizar
+            </button>
+            <div className="flex items-center gap-1">
+                {fuentesSucursal.map(f => (
+                    <span
+                        key={f.fuente}
+                        title={f.ultimo_error_msg || undefined}
+                        className={`flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full ${
+                            f.desactualizado
+                                ? 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400'
+                                : 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400'
+                        }`}
+                    >
+                        {f.desactualizado ? <AlertTriangle className="w-3 h-3" /> : <CheckCircle2 className="w-3 h-3" />}
+                        {NOMBRE_FUENTE[f.fuente] || f.fuente} {formatearAntiguedad(f.minutos_desde_ok)}
+                    </span>
+                ))}
+            </div>
+            {error && <span className="text-[11px] text-red-600 dark:text-red-400">{error}</span>}
+        </div>
+    );
+}
