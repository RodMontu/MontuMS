+                    className="truncate uppercase font-bold"
+                    style={{ color: obraColor.textColor, fontSize: '10px' }}
+                    title={ev.codigo_viaje || ev.id_tarea}
+                >
+                    {ev.codigo_viaje || ev.id_tarea}
+                </span>
+            )}
 
             {/* Line 3: ONLY if delayed — red warning indicator */}
             {ev.dias_atraso != null && ev.dias_atraso > 0 && (
@@ -1098,6 +1119,7 @@ export default function GestorProgramacion({ sucursal, turnoGlobal = 'Día', ave
                     nr_piezas: t.nr_piezas,
