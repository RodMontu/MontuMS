         return () => { cancelado = true; };
     }, [selectedTarea?.codigo_viaje, selectedTarea?.lista_etiqueta_ids, sucursal]);
 
+    // B44(a): limpiar el input del ajuste de duracion cada vez que se abre
+    // una cajita distinta (no arrastrar el valor de la anterior).
+    useEffect(() => {
+        setAjusteDuracionInput('');
+    }, [selectedTarea?.id_tarea]);
+
+    const handleGuardarAjusteDuracion = async () => {
+        const minutos = parseInt(ajusteDuracionInput, 10);
+        if (!selectedTarea?.id_tarea || !Number.isFinite(minutos) || minutos <= 0) return;
+        let usuario = 'desconocido';
+        try {
+            const stored = localStorage.getItem('auth_user');
+            if (stored) usuario = JSON.parse(stored)?.nombre || JSON.parse(stored)?.email || usuario;
+        } catch { /* usuario queda 'desconocido' */ }
+
+        setAjusteDuracionGuardando(true);
+        try {
+            const res = await fetch('/api/programacion/ajuste-duracion', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({
+                    sucursal_id: Number(sucursal),
+                    turno: turnoGlobal,
+                    fecha,
+                    id_tarea: selectedTarea.id_tarea,
+                    minutos,
+                    usuario,
+                }),
+            });
+            const json = await res.json();
+            if (res.ok && json.fecha_fin) {
+                const idTarea = selectedTarea.id_tarea;
+                setSelectedTarea(prev => prev ? { ...prev, fecha_fin: json.fecha_fin, duracion_min: minutos } : prev);
+                setData(prev => ({
+                    ...prev,
+                    eventos: prev.eventos.map((e: any) => e.id_tarea === idTarea ? { ...e, fecha_fin: json.fecha_fin, duracion_min: minutos } : e),
+                }));
+            }
+        } catch (e) {
+            console.error('[B44a] Error guardando ajuste de duracion:', e);
+        } finally {
+            setAjusteDuracionGuardando(false);
+        }
+    };
+
     const fetchEstadosAveriasMaquinas = useCallback(() => {
