+"""
+B44(b) — Capacidad real de máquina (jefe de planta). Pruebas AC1-AC7.
+
+Ejecutar: python -m unittest test_b44b_capacidad_real -v
+
+Corre sobre una COPIA de la SQLite real en /tmp (nunca sobre optifierro_v2.db
+del contenedor). No requiere Cubigest: prueba directamente las funciones del
+router (guardado, limpieza, lectura vigente), no el endpoint GET completo
+(ese requiere Cubigest y se verifica aparte con una llamada real de solo
+lectura).
+"""
+import os
+import shutil
+import sqlite3
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, "/app")
+
+import routers.tiempos_maquina as tm  # noqa: E402
+from fastapi import HTTPException  # noqa: E402
+
+
+class TestB44bCapacidadReal(unittest.TestCase):
+
+    def setUp(self):
+        self._tmpdir = tempfile.mkdtemp(prefix="b44b_test_")
+        self._tmp_db = os.path.join(self._tmpdir, "copia_optifierro_v2.db")
+        shutil.copyfile("/app/optifierro_v2.db", self._tmp_db)
+        self._orig_db_path = tm.DB_PATH
+        tm.DB_PATH = self._tmp_db
+        tm._ensure_tabla_capacidad_real()
+
+    def tearDown(self):
+        tm.DB_PATH = self._orig_db_path
+        shutil.rmtree(self._tmpdir, ignore_errors=True)
+
+    def test_ac1_tabla_se_crea_vacia(self):
+        vigentes = tm._capacidades_reales_vigentes(id_forma=421, diametro=12.0)
+        self.assertEqual(vigentes, {})
+
+    def test_ac2_guardar_y_leer_vigente(self):
+        payload = tm.CapacidadRealPayload(
+            sucursal_id=10, maquina_id=5, id_forma=421, diametro=12.0,
+            ton_hora=3.5, usuario="Jose Auger",
+        )
+        resultado = tm.guardar_capacidad_real(payload)
+        self.assertTrue(resultado["ok"])
+        self.assertEqual(resultado["ton_hora"], 3.5)
+
+        vigentes = tm._capacidades_reales_vigentes(id_forma=421, diametro=12.0)
+        self.assertIn((10, 5), vigentes)
+        self.assertEqual(vigentes[(10, 5)]["ton_hora"], 3.5)
+        self.assertEqual(vigentes[(10, 5)]["usuario"], "Jose Auger")
+
+    def test_ac3_actualizar_conserva_historial_append_only(self):
+        base = dict(sucursal_id=14, maquina_id=7, id_forma=500, diametro=16.0, usuario="Remiz")
+        tm.guardar_capacidad_real(tm.CapacidadRealPayload(**base, ton_hora=2.0))
+        tm.guardar_capacidad_real(tm.CapacidadRealPayload(**base, ton_hora=2.8))
+
+        vigentes = tm._capacidades_reales_vigentes(id_forma=500, diametro=16.0)
+        self.assertEqual(vigentes[(14, 7)]["ton_hora"], 2.8)
+
+        with sqlite3.connect(tm.DB_PATH) as conn:
+            n = conn.execute(
+                "SELECT COUNT(*) FROM capacidad_real_maquina WHERE sucursal_id=14 AND maquina_id=7"
+            ).fetchone()[0]
+        self.assertEqual(n, 2)
+
+    def test_ac4_limpiar_deja_vigente_nulo_sin_borrar_historial(self):
+        base = dict(sucursal_id=1, maquina_id=9, id_forma=600, diametro=10.0, usuario="Montu")
+        tm.guardar_capacidad_real(tm.CapacidadRealPayload(**base, ton_hora=4.1))
+        tm.limpiar_capacidad_real(
+            tm.CapacidadRealClearPayload(
+                sucursal_id=1, maquina_id=9, id_forma=600, diametro=10.0, usuario="Montu"
+            )
+        )
+        vigentes = tm._capacidades_reales_vigentes(id_forma=600, diametro=10.0)
+        self.assertNotIn((1, 9), vigentes)
+
+        with sqlite3.connect(tm.DB_PATH) as conn:
+            n = conn.execute(
+                "SELECT COUNT(*) FROM capacidad_real_maquina WHERE sucursal_id=1 AND maquina_id=9"
+            ).fetchone()[0]
+        self.assertEqual(n, 2)  # guardado + limpieza, ninguna fila borrada
+
+    def test_ac5_validacion_ton_hora_fuera_de_rango(self):
+        with self.assertRaises(Exception):
+            tm.CapacidadRealPayload(
+                sucursal_id=10, maquina_id=1, id_forma=1, diametro=8.0,
+                ton_hora=0, usuario="x",
+            )
+        with self.assertRaises(Exception):
+            tm.CapacidadRealPayload(
+                sucursal_id=10, maquina_id=1, id_forma=1, diametro=8.0,
+                ton_hora=51, usuario="x",
+            )
+
+    def test_ac6_validacion_sucursal_invalida(self):
+        payload = tm.CapacidadRealPayload(
+            sucursal_id=4, maquina_id=1, id_forma=1, diametro=8.0,
+            ton_hora=3.0, usuario="x",
+        )  # 4 es Cerrillos en Cubigest, NO en SQLite (FP-006) -> debe rechazarse
+        with self.assertRaises(HTTPException) as ctx:
+            tm.guardar_capacidad_real(payload)
+        self.assertEqual(ctx.exception.status_code, 400)
+
+    def test_ac7_clave_es_por_forma_y_diametro_no_cruza(self):
+        base = dict(sucursal_id=10, maquina_id=2, usuario="x")
+        tm.guardar_capacidad_real(tm.CapacidadRealPayload(**base, id_forma=1, diametro=12.0, ton_hora=3.0))
+        tm.guardar_capacidad_real(tm.CapacidadRealPayload(**base, id_forma=1, diametro=16.0, ton_hora=4.0))
+
+        vig_12 = tm._capacidades_reales_vigentes(id_forma=1, diametro=12.0)
+        vig_16 = tm._capacidades_reales_vigentes(id_forma=1, diametro=16.0)
+        self.assertEqual(vig_12[(10, 2)]["ton_hora"], 3.0)
+        self.assertEqual(vig_16[(10, 2)]["ton_hora"], 4.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
