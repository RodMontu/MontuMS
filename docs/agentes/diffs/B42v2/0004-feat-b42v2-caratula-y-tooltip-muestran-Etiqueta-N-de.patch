-            <span
-                className="truncate uppercase font-bold"
-                style={{ color: obraColor.textColor, fontSize: '10px' }}
-                title={ev.numero_etiqueta != null ? `Etiqueta ${ev.numero_etiqueta} — Viaje ${ev.codigo_viaje}` : (ev.codigo_viaje || ev.id_tarea)}
-            >
-                {ev.numero_etiqueta != null ? `Etiq. ${ev.numero_etiqueta}` : (ev.codigo_viaje || ev.id_tarea)}
-            </span>
-
-            {/* Line 2: TAG count - slightly smaller */}
-            <span
-                className="truncate opacity-90"
-                style={{ color: obraColor.textColor, fontSize: '9px' }}
-            >
-                {ev.nr_tags ?? 1} TAGs
-            </span>
+            {/* B42 v2: una cajita = una etiqueta. Prioridad de lectura cuando la
+                cajita es angosta (spec B42_v2 §10/§12, decision Montu 24-09):
+                Diametro > Etiqueta N de M > Peso > Viaje. Cada linea trunca con
+                ellipsis (CSS puro, sin min-width ni JS) — lo que no entra se
+                omite visualmente y queda disponible en el tooltip on-hover.
+                Fallback a lo que se mostraba hoy (viaje/id_tarea) si el plan
+                vigente no trae numero_etiqueta (ej. generado antes del deploy
+                o por el scheduler automatico sin Cubigest.Etiqueta). */}
+            {ev.numero_etiqueta != null ? (
+                <>
+                    <span
+                        className="truncate uppercase font-bold"
+                        style={{ color: obraColor.textColor, fontSize: '10px' }}
+                        title={`Ø${ev.diametro} — Etiqueta ${ev.numero_etiqueta}${ev.total_etiquetas != null ? ` de ${ev.total_etiquetas}` : ''} — Viaje ${ev.codigo_viaje}`}
+                    >
+                        {`Ø${ev.diametro} · ${ev.numero_etiqueta}${ev.total_etiquetas != null ? ` de ${ev.total_etiquetas}` : ''}`}
