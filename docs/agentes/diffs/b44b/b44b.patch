+def _ensure_tabla_capacidad_real():
+    """Tabla append-only: cada guardado/limpieza inserta una fila nueva.
+
+    Clave logica = (sucursal_id, maquina_id, id_forma, diametro). El valor
+    vigente es la fila de mayor id para esa clave; ton_hora NULL representa
+    una limpieza (se conserva el historial en vez de borrar filas).
+    """
+    with sqlite3.connect(DB_PATH, timeout=10) as conn:
+        conn.execute("""
+            CREATE TABLE IF NOT EXISTS capacidad_real_maquina (
+                id           INTEGER PRIMARY KEY AUTOINCREMENT,
+                sucursal_id  INTEGER NOT NULL,
+                maquina_id   INTEGER NOT NULL,
+                id_forma     INTEGER NOT NULL,
+                diametro     REAL    NOT NULL,
+                ton_hora     REAL,
+                usuario      TEXT    NOT NULL,
+                nota         TEXT,
+                creado_en    TIMESTAMP DEFAULT CURRENT_TIMESTAMP
+            )
+        """)
+        conn.execute("""
+            CREATE INDEX IF NOT EXISTS idx_capacidad_real_clave
+            ON capacidad_real_maquina (sucursal_id, maquina_id, id_forma, diametro)
+        """)
