+
+def _capacidades_reales_vigentes(id_forma: int, diametro: float) -> dict[tuple, dict]:
+    """Ultimo valor (por id) de cada (sucursal_id, maquina_id) para esta forma+diametro."""
+    with sqlite3.connect(DB_PATH, timeout=10) as conn:
+        conn.row_factory = sqlite3.Row
+        rows = conn.execute(
+            """
+            SELECT c.sucursal_id, c.maquina_id, c.ton_hora, c.usuario, c.nota, c.creado_en
+            FROM capacidad_real_maquina c
+            WHERE c.id_forma = ? AND c.diametro = ?
+              AND c.id = (
+                  SELECT MAX(c2.id) FROM capacidad_real_maquina c2
+                  WHERE c2.sucursal_id = c.sucursal_id
+                    AND c2.maquina_id  = c.maquina_id
+                    AND c2.id_forma    = c.id_forma
+                    AND c2.diametro    = c.diametro
+              )
+            """,
+            (id_forma, diametro),
+        ).fetchall()
+    resultado = {}
+    for r in rows:
+        if r["ton_hora"] is None:
+            continue  # ultima accion fue una limpieza: no hay capacidad real vigente
+        resultado[(r["sucursal_id"], r["maquina_id"])] = {
+            "ton_hora":       r["ton_hora"],
+            "usuario":        r["usuario"],
+            "nota":           r["nota"],
+            "actualizado_en": r["creado_en"],
+        }
+    return resultado
+
+
+@router.put("/tiempos-maquina/capacidad-real")
