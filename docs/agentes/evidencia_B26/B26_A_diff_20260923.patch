+def _percentil(valores: list[float], p: float) -> Optional[float]:
+    """Percentil por interpolacion lineal (p en [0, 1])."""
+    if not valores:
+        return None
+    ordenados = sorted(valores)
+    n = len(ordenados)
+    if n == 1:
+        return ordenados[0]
+    idx = p * (n - 1)
+    lo = int(idx)
+    hi = min(lo + 1, n - 1)
+    frac = idx - lo
+    return ordenados[lo] + (ordenados[hi] - ordenados[lo]) * frac
 
 
