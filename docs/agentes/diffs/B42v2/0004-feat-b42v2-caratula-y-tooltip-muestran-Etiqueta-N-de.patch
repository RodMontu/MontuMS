     numero_etiqueta?: number | null;
+    // B42 v2: total de etiquetas del grupo fisico ("N of M" -> M).
+    total_etiquetas?: number | null;
     // B44(a): true si esta cajita tiene un ajuste manual de duracion vigente.
     ajuste_manual?: boolean;
     // B43 (fix): senal real de "adelantada" - true si esta cajita viene de la
@@ -421,24 +423,43 @@ function DraggableTimelineEvent({ ev, setHoveredEvent, setTooltipPos, getEventSt
                 fontFamily: "'Inter', 'Segoe UI', system-ui, sans-serif",
