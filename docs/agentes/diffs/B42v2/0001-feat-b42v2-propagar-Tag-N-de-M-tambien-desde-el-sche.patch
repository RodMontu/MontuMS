     # para que _tarea_a_evento y /tags-viaje lo puedan mostrar en la cajita.
-    from database_cubigest import parse_numero_etiqueta
+    # B42 v2: ademas se anota N/M directo en el dict de cada etiqueta (D4).
+    from database_cubigest import parse_numero_y_total_etiqueta
     for f in filas:
         eid = f.get("etiqueta_id")
+        n, m = parse_numero_y_total_etiqueta(f.get("etiqueta_raw"))
+        f["numero_etiqueta"] = n
+        f["total_etiquetas"] = m
         if eid is not None:
-            _mapa_numero_etiqueta[eid] = parse_numero_etiqueta(f.get("etiqueta_raw"))
+            _mapa_numero_etiqueta[eid] = n
 
