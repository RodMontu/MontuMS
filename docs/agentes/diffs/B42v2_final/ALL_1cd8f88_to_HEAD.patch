+                env = dict(os.environ)
+                env["PYTHONHASHSEED"] = seed
+                env["UNV"] = universo_path
+                out = subprocess.run(
+                    [sys.executable, "-c", runner], env=env,
+                    capture_output=True, text=True, timeout=120,
+                )
+                self.assertEqual(out.returncode, 0, f"seed={seed} fallo: {out.stderr[-2000:]}")
+                linea = [l for l in out.stdout.splitlines() if l.startswith("SIG")]
+                self.assertTrue(linea, f"seed={seed} sin salida SIG: {out.stdout!r} {out.stderr[-500:]!r}")
+                firmas[seed] = linea[0]
+            self.assertEqual(
+                len(set(firmas.values())), 1,
+                f"NO DETERMINISTA: firmas distintas entre semillas (K1): {firmas}",
+            )
+        finally:
