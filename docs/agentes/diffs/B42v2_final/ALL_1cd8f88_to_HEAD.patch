 backend/routers/programacion.py | 25 ++++++++++++++++++++++---
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/backend/database_cubigest.py b/backend/database_cubigest.py
index 3ae1b77..7c01858 100644
--- a/backend/database_cubigest.py
+++ b/backend/database_cubigest.py
@@ -34,6 +34,19 @@ def parse_numero_etiqueta(etiqueta_raw: str | None) -> int | None:
     return int(m.group(1)) if m else None
 
 
+def parse_numero_y_total_etiqueta(etiqueta_raw: str | None) -> tuple[int | None, int | None]:
+    """
+    Igual que parse_numero_etiqueta, pero tambien devuelve M (total de
+    etiquetas del grupo fisico, "Tag #: N of M") — B42 v2, "Etiqueta N de M".
+    """
+    if not etiqueta_raw:
+        return None, None
+    m = _RE_NUMERO_ETIQUETA.search(str(etiqueta_raw))
+    if not m:
+        return None, None
+    return int(m.group(1)), int(m.group(2))
+
+
 class CubigestDB:
     _instance = None
 
