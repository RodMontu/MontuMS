+++ b/backend/routers/sync.py
@@ -0,0 +1,253 @@
+"""
+Sincronizacion unificada (CCa-17, pasos 1/2/5 del diseno CCa-11):
+un unico punto que actualiza JUNTAS las dos fuentes de datos del SPP:
+
+  (a) "universo" de compromisos: no tiene cache propio, se consulta en vivo
+      a Cubigest en cada endpoint (_obtener_pids_pendientes y las 2 queries
+      hermanas en materias_primas.py / database_cubigest.py). "Actualizar"
+      aqui significa validar que Cubigest responde (SELECT liviano) y dejar
+      constancia en sync_estado -- NO se inventa un cache nuevo.
+  (b) "Cuadro de Programacion" OptiSteel: si tiene cache (SQLite,
+      cuadro_programacion_optisteel), refrescado hoy solo por un servicio
+      externo (Geovictoria en serverX:8002) que llama
+      POST /api/admin/cuadro-programacion/ejecutar. Aqui se llama
+      directamente scrape_cuadro_programacion (mismo proceso, sin salto de
+      red) para las 3 sucursales, semana actual (lunes-sabado, TO no
+      despacha domingo).
+
+Si (b) falla, scrape_cuadro_programacion ya garantiza (por diseno: el
+DELETE/INSERT ocurre despues del parseo completo) que los datos previos del
+Cuadro quedan intactos -- aqui solo se registra el error en sync_estado, sin
+reintentar ni pisar nada.
+"""
+import asyncio
+import logging
+import os
+import sqlite3
+import time
+from datetime import date, datetime, timedelta, timezone
+
+from fastapi import APIRouter, HTTPException
+from fastapi.concurrency import run_in_threadpool
+from pydantic import BaseModel
+
+from database_cubigest import cubigest_db
+from scraper_cuadroprogramacion import scrape_cuadro_programacion
+
+logger = logging.getLogger(__name__)
+router = APIRouter(prefix="/api/sync", tags=["sync"])
+
+DB_PATH = os.getenv("DB_PATH", "optifierro_v2.db")
+
+SUCURSALES = [1, 10, 14]
+SUCURSAL_NOMBRES = {1: "Calama", 10: "Cerrillos", 14: "Coronel"}
+# sucursal_id OptiFierro -> nombre de combo Cubigest (scraper_cuadroprogramacion.SUCURSALES)
+SUCURSAL_A_CUADRO = {1: "CALAMA", 10: "SANTIAGO", 14: "CORONEL"}
+
+FUENTES = ("universo", "cuadro")
+
+UMBRAL_DESACTUALIZADO_MIN = int(os.getenv("SYNC_DESACTUALIZADO_MIN", "90"))
+TIMEOUT_UNIVERSO_S = 10.0
+TIMEOUT_CUADRO_S = 60.0
+
+# Un solo sync a la vez (botón + job horario comparten este lock).
+_sync_lock = asyncio.Lock()
+
+CREATE_TABLE_SQL = """
+CREATE TABLE IF NOT EXISTS sync_estado (
+    fuente TEXT NOT NULL,
+    sucursal_id INTEGER NOT NULL,
+    ultimo_ok_ts TEXT,
+    ultimo_error_ts TEXT,
+    ultimo_error_msg TEXT,
+    duracion_ms INTEGER,
+    PRIMARY KEY (fuente, sucursal_id)
+)
+"""
+
+
+def _init_tabla() -> None:
+    with sqlite3.connect(DB_PATH) as conn:
+        conn.execute(CREATE_TABLE_SQL)
+        conn.commit()
+
+
+def _registrar_ok(fuente: str, sucursal_id: int, duracion_ms: int) -> None:
+    _init_tabla()
+    with sqlite3.connect(DB_PATH) as conn:
+        conn.execute(
+            """INSERT INTO sync_estado (fuente, sucursal_id, ultimo_ok_ts, duracion_ms)
+               VALUES (?, ?, datetime('now'), ?)
+               ON CONFLICT(fuente, sucursal_id) DO UPDATE SET
+                   ultimo_ok_ts = excluded.ultimo_ok_ts,
+                   duracion_ms  = excluded.duracion_ms""",
+            (fuente, sucursal_id, duracion_ms),
+        )
+        conn.commit()
+
+
+def _registrar_error(fuente: str, sucursal_id: int, duracion_ms: int, mensaje: str) -> None:
+    _init_tabla()
+    with sqlite3.connect(DB_PATH) as conn:
+        conn.execute(
+            """INSERT INTO sync_estado (fuente, sucursal_id, ultimo_error_ts, ultimo_error_msg, duracion_ms)
+               VALUES (?, ?, datetime('now'), ?, ?)
+               ON CONFLICT(fuente, sucursal_id) DO UPDATE SET
+                   ultimo_error_ts  = excluded.ultimo_error_ts,
+                   ultimo_error_msg = excluded.ultimo_error_msg,
+                   duracion_ms      = excluded.duracion_ms""",
+            (fuente, sucursal_id, mensaje[:500], duracion_ms),
+        )
+        conn.commit()
+
+
+def _verificar_cubigest_vivo(sucursal_id: int) -> None:
+    """Query liviana para confirmar que Cubigest responde. Lanza si falla."""
+    cub_ids = cubigest_db.get_cubigest_sucursal_ids(sucursal_id)
+    conn = cubigest_db.connect()
+    if conn is None:
+        raise RuntimeError("Cubigest no disponible (connect() devolvió None)")
+    try:
+        cur = conn.cursor()
+        cur.execute("SELECT TOP 1 it.Id FROM IT it WHERE it.IdSucursal IN ({})".format(
+            ",".join("?" * len(cub_ids))
+        ), tuple(cub_ids))
+        cur.fetchall()
+    finally:
+        conn.close()
+
+
+def _rango_semana_actual() -> tuple[str, str]:
+    """Lunes..sábado de la semana actual, formato dd-mm-aaaa (mismo criterio
+    que scraper_cuadroprogramacion.py __main__: TO no despacha domingo)."""
+    hoy = date.today()
+    lunes = hoy - timedelta(days=hoy.weekday())
+    sabado = lunes + timedelta(days=5)
+    return lunes.strftime("%d-%m-%Y"), sabado.strftime("%d-%m-%Y")
+
+
+async def _sync_universo(sucursal_id: int) -> dict:
+    t0 = time.monotonic()
+    try:
+        await asyncio.wait_for(
+            run_in_threadpool(_verificar_cubigest_vivo, sucursal_id),
+            timeout=TIMEOUT_UNIVERSO_S,
+        )
+        dur_ms = int((time.monotonic() - t0) * 1000)
+        _registrar_ok("universo", sucursal_id, dur_ms)
+        return {"fuente": "universo", "sucursal_id": sucursal_id, "ok": True, "duracion_ms": dur_ms}
+    except Exception as e:
+        dur_ms = int((time.monotonic() - t0) * 1000)
+        msg = str(e) if not isinstance(e, asyncio.TimeoutError) else f"timeout > {TIMEOUT_UNIVERSO_S}s"
+        logger.error(f"[sync] universo sucursal={sucursal_id}: {msg}")
+        _registrar_error("universo", sucursal_id, dur_ms, msg)
+        return {"fuente": "universo", "sucursal_id": sucursal_id, "ok": False, "duracion_ms": dur_ms, "error": msg}
+
+
+async def _sync_cuadro(sucursal_id: int) -> dict:
+    t0 = time.monotonic()
+    nombre_cuadro = SUCURSAL_A_CUADRO[sucursal_id]
+    desde, hasta = _rango_semana_actual()
+    try:
+        resultado = await asyncio.wait_for(
+            run_in_threadpool(scrape_cuadro_programacion, nombre_cuadro, desde, hasta),
+            timeout=TIMEOUT_CUADRO_S,
+        )
+        dur_ms = int((time.monotonic() - t0) * 1000)
+        _registrar_ok("cuadro", sucursal_id, dur_ms)
+        return {"fuente": "cuadro", "sucursal_id": sucursal_id, "ok": True, "duracion_ms": dur_ms,
+                "registros": resultado.get("registros")}
+    except Exception as e:
+        dur_ms = int((time.monotonic() - t0) * 1000)
+        msg = str(e) if not isinstance(e, asyncio.TimeoutError) else f"timeout > {TIMEOUT_CUADRO_S}s"
+        # scrape_cuadro_programacion garantiza (DELETE/INSERT tras el parseo
+        # completo) que si esto se dispara, el Cuadro previo NO se pisó.
+        logger.error(f"[sync] cuadro sucursal={sucursal_id} ({nombre_cuadro}): {msg}")
+        _registrar_error("cuadro", sucursal_id, dur_ms, msg)
+        return {"fuente": "cuadro", "sucursal_id": sucursal_id, "ok": False, "duracion_ms": dur_ms, "error": msg}
+
+
+async def ejecutar_sync(sucursales: list[int] | None = None) -> dict:
+    """
+    Orquesta universo (a) y Cuadro (b), en ese orden, por cada sucursal.
+    Nunca reporta éxito global si una fuente falló. Usado tanto por
+    POST /api/sync/ejecutar como por el job horario de main.py.
+    """
+    sucs = sucursales or SUCURSALES
+    for s in sucs:
+        if s not in SUCURSAL_NOMBRES:
+            raise ValueError(f"sucursal_id inválido: {s}")
+
+    if _sync_lock.locked():
+        raise RuntimeError("Ya hay una sincronización en curso")
+
+    async with _sync_lock:
+        resultados = []
+        for suc in sucs:
+            resultados.append(await _sync_universo(suc))
+            resultados.append(await _sync_cuadro(suc))
+
+    ok_global = all(r["ok"] for r in resultados)
+    return {
+        "ok": ok_global,
+        "ejecutado_en": datetime.now(timezone.utc).isoformat(),
+        "resultados": resultados,
+    }
+
+
+class SyncBody(BaseModel):
+    sucursal_id: int | None = None
+
+
+@router.post("/ejecutar")
+async def sync_ejecutar(body: SyncBody | None = None):
+    sucursales = [body.sucursal_id] if (body and body.sucursal_id) else None
+    try:
+        return await ejecutar_sync(sucursales)
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+    except RuntimeError as e:
+        raise HTTPException(status_code=409, detail=str(e))
+
+
+@router.get("/estado")
+async def sync_estado():
+    _init_tabla()
+    with sqlite3.connect(DB_PATH) as conn:
+        conn.row_factory = sqlite3.Row
+        rows = {
+            (r["fuente"], r["sucursal_id"]): r
+            for r in conn.execute("SELECT * FROM sync_estado").fetchall()
+        }
+
+    ahora = datetime.now(timezone.utc)
+    fuentes_out = []
+    for fuente in FUENTES:
+        for suc in SUCURSALES:
+            row = rows.get((fuente, suc))
+            ultimo_ok_ts = row["ultimo_ok_ts"] if row else None
+            minutos_desde_ok = None
+            if ultimo_ok_ts:
+                try:
+                    ts = datetime.fromisoformat(ultimo_ok_ts).replace(tzinfo=timezone.utc)
+                    minutos_desde_ok = round((ahora - ts).total_seconds() / 60, 1)
+                except Exception:
+                    minutos_desde_ok = None
+            desactualizado = minutos_desde_ok is None or minutos_desde_ok > UMBRAL_DESACTUALIZADO_MIN
+            fuentes_out.append({
+                "fuente": fuente,
+                "sucursal_id": suc,
+                "sucursal": SUCURSAL_NOMBRES[suc],
+                "ultimo_ok_ts": ultimo_ok_ts,
+                "ultimo_error_ts": row["ultimo_error_ts"] if row else None,
+                "ultimo_error_msg": row["ultimo_error_msg"] if row else None,
+                "duracion_ms": row["duracion_ms"] if row else None,
+                "minutos_desde_ok": minutos_desde_ok,
+                "desactualizado": desactualizado,
+            })
+
+    return {
+        "umbral_desactualizado_min": UMBRAL_DESACTUALIZADO_MIN,
+        "sincronizando": _sync_lock.locked(),
+        "fuentes": fuentes_out,
+    }
