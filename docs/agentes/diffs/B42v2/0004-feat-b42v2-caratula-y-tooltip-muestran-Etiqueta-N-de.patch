                 }));
                 const pendientesNormalizados = result.bolsa_sin_asignar.map((p: any) => ({
                     id_tarea: String(p.etiqueta_id),
@@ -1765,10 +1787,12 @@ export default function GestorProgramacion({ sucursal, turnoGlobal = 'Día', ave
                             transform: tooltipPos.x > window.innerWidth - 310 ? 'translateX(-100%)' : undefined,
                         }}
                     >
-                        {/* Fila 1: numero de etiqueta (B42) + viaje + badge prioridad */}
