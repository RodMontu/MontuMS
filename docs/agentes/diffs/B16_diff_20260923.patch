+"""
+B16 — Capacidad de planta por jornada (minutos-hombre). Pruebas AC1-AC9.
+
+Ejecutar: python -m unittest test_b16_capacidad -v
+
+AC8 (no invasivo) no se cubre acá: requiere un diff de eventos de /generar
+antes/después de B16 con datos reales, corrido en el arnes del contenedor
+(ver CCa5_b16_implementacion_20260923.md).
+"""
+import unittest
+from motor_v2 import _calcular_capacidad_mh, _ventana_turno, _get_config_turno
+
+
+def _ventana_cerrillos_dia(fecha="2026-09-21"):  # lunes, no viernes
+    config = _get_config_turno("dia", fecha, sucursal_id=None)
+    return (fecha,) + _ventana_turno(fecha, config)
+
+
+def _ventana_noche(fecha="2026-09-21"):
+    config = _get_config_turno("noche", fecha, sucursal_id=None)
+    return (fecha,) + _ventana_turno(fecha, config)
+
+
+def _presencia(operadores, fuente="geovictoria"):
+    return {"fuente": fuente, "operadores": operadores}
+
+
+def _full(n, prefix="op"):
+    return [{"username": f"{prefix}{i}", "entrada": None, "salida": None} for i in range(n)]
+
+
+class TestB16Capacidad(unittest.TestCase):
+
+    def test_ac1_propiedad_misma_ventana_mismos_operadores(self):
+        fecha, h_ini, h_fin, b_ini, b_fin = _ventana_cerrillos_dia("2026-09-21")
+        cap_a = _calcular_capacidad_mh(fecha, h_ini, h_fin, b_ini, b_fin, _presencia(_full(8)))
+        fecha2, h_ini2, h_fin2, b_ini2, b_fin2 = _ventana_cerrillos_dia("2026-09-14")  # otro lunes
+        cap_b = _calcular_capacidad_mh(fecha2, h_ini2, h_fin2, b_ini2, b_fin2, _presencia(_full(8)))
+        self.assertEqual(cap_a["capacidad_mh"], cap_b["capacidad_mh"])
+
+    def test_ac2_cerrillos_dia_8_operadores_completos(self):
+        fecha, h_ini, h_fin, b_ini, b_fin = _ventana_cerrillos_dia()
+        self.assertEqual(h_ini.strftime("%H:%M"), "08:15")
+        self.assertEqual(h_fin.strftime("%H:%M"), "17:45")
+        cap = _calcular_capacidad_mh(fecha, h_ini, h_fin, b_ini, b_fin, _presencia(_full(8)))
+        self.assertEqual(cap["min_utiles_planta"], 510.0)
+        self.assertEqual(cap["capacidad_mh"], 4080.0)
+        self.assertEqual(cap["operadores_contados"], 8)
+        self.assertEqual(cap["operadores_parciales"], [])
+
+    def test_ac3_ausencia_parcial_umbral_30min(self):
+        fecha, h_ini, h_fin, b_ini, b_fin = _ventana_cerrillos_dia()
+
+        # Entrada 10:30 (salida en hora normal) -> ventana 10:30-17:45 = 435 - 60 colacion = 375
+        cap = _calcular_capacidad_mh(
+            fecha, h_ini, h_fin, b_ini, b_fin,
+            _presencia([{"username": "op1", "entrada": "10:30", "salida": "17:45"}]),
+        )
+        self.assertEqual(cap["capacidad_mh"], 375.0)
+        self.assertEqual(cap["operadores_parciales"], [{"username": "op1", "min_utiles": 375.0}])
+
+        # Entrada 08:40 (25 min, < 30) -> ventana completa 510
+        cap = _calcular_capacidad_mh(
+            fecha, h_ini, h_fin, b_ini, b_fin,
+            _presencia([{"username": "op1", "entrada": "08:40", "salida": "17:45"}]),
+        )
+        self.assertEqual(cap["capacidad_mh"], 510.0)
+        self.assertEqual(cap["operadores_parciales"], [])
+
+        # Entrada 08:45 (30 min, >= 30) -> parcial: 480
+        cap = _calcular_capacidad_mh(
+            fecha, h_ini, h_fin, b_ini, b_fin,
+            _presencia([{"username": "op1", "entrada": "08:45", "salida": "17:45"}]),
+        )
+        self.assertEqual(cap["capacidad_mh"], 480.0)
+
+    def test_ac4_colacion_no_se_descuenta_si_no_intersecta(self):
+        fecha, h_ini, h_fin, b_ini, b_fin = _ventana_cerrillos_dia()
+        # Salida 12:30 (entrada en hora normal) -> 08:15-12:30 = 255 min, sin descuento de colacion (13-14)
+        cap = _calcular_capacidad_mh(
+            fecha, h_ini, h_fin, b_ini, b_fin,
+            _presencia([{"username": "op1", "entrada": "08:15", "salida": "12:30"}]),
+        )
+        self.assertEqual(cap["capacidad_mh"], 255.0)
+
+    def test_ac5_turno_noche_cruza_medianoche(self):
+        fecha, h_ini, h_fin, b_ini, b_fin = _ventana_noche()
+        self.assertEqual(h_ini.strftime("%H:%M"), "20:15")
+        self.assertEqual(h_fin.strftime("%H:%M"), "05:45")
+        cap = _calcular_capacidad_mh(fecha, h_ini, h_fin, b_ini, b_fin, _presencia(_full(1)))
+        self.assertEqual(cap["capacidad_mh"], 510.0)
+
+    def test_ac6_ar009_operador_en_2_o_mas_maquinas_cuenta_una_vez(self):
+        fecha, h_ini, h_fin, b_ini, b_fin = _ventana_cerrillos_dia()
+        # Mismo username repetido (simula que califica para 3 maquinas)
+        cap = _calcular_capacidad_mh(
+            fecha, h_ini, h_fin, b_ini, b_fin,
+            _presencia([
