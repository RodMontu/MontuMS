                         <div className="flex justify-between items-center px-4 pt-3 pb-2">
                             <span className="text-base font-black text-white tracking-tight">
-                                {hoveredEvent.numero_etiqueta != null ? `Etiq. ${hoveredEvent.numero_etiqueta}` : hoveredEvent.codigo_viaje}
+                                {hoveredEvent.numero_etiqueta != null
+                                    ? `Etiqueta ${hoveredEvent.numero_etiqueta}${hoveredEvent.total_etiquetas != null ? ` de ${hoveredEvent.total_etiquetas}` : ''}`
