+class TestB42v2K2Reparto(unittest.TestCase):
+    """K2 (CCa-14): auto-reparto en paralelo evaluado a nivel de SERIE. Una
+    serie "filler" (8 etiquetas x 1000 kg, IdForma=2 Ø10mm -> PRIMA 3D)
+    consume ~275 min de PRIMA 3D desde el inicio del turno; una segunda
+    serie "target" (12 etiquetas x 1000 kg, mismo IdForma/diametro, viaje
+    distinto) queda con < 300 min libres en PRIMA 3D, con duracion de
+    serie completa (~413 min) que excede ese remanente -> debe repartirse
+    en 2 bloques contiguos de 6 etiquetas (~50/50 kg) entre PRIMA 3D y la
+    maquina sugerida (EURA 16, unica alternativa Ø10mm elegible en este
+    universo sintetico)."""
+
+    def test_k2_serie_larga_se_reparte_en_2_bloques_2_maquinas(self):
+        filler = [
+            _etiqueta(eid=9000 + i, kgs=1000.0, id_forma=2, diametro=10,
+                      codigo_viaje="K2-FILLER/1", n=i + 1, m=8)
+            for i in range(8)
+        ]
+        target = [
+            _etiqueta(eid=9100 + i, kgs=1000.0, id_forma=2, diametro=10,
+                      codigo_viaje="K2-TARGET/1", n=i + 1, m=12)
+            for i in range(12)
+        ]
+        resultado = _run(filler + target)
+        tareas = resultado["tareas"]
+        bolsa = resultado["bolsa_sin_asignar"]
+
+        target_ids = {e["etiqueta_id"] for e in target}
+        target_tareas = [t for t in tareas if t["etiqueta_id"] in target_ids]
+        target_bolsa = [b for b in bolsa if b["etiqueta_id"] in target_ids]
+
+        # Conservacion: las 12 etiquetas de la serie larga deben conservarse
+        # (0 a bolsa) -- si no hay split, varias caerian a turno_lleno.
+        self.assertEqual(len(target_tareas), 12, f"faltan etiquetas de la serie target en tareas: bolsa={target_bolsa}")
+        self.assertEqual(len(target_bolsa), 0)
+        self.assertAlmostEqual(sum(t["kilos"] for t in target_tareas), 12000.0, places=1)
+
+        maquinas_target = {t["nombre_maquina"] for t in target_tareas}
+        self.assertEqual(len(maquinas_target), 2, f"se esperaban exactamente 2 maquinas, hubo: {maquinas_target}")
+
+        # serie_repartida: true en TODAS las tareas de ambos bloques.
+        self.assertTrue(all(t.get("serie_repartida") is True for t in target_tareas))
+
+        # alerta_reparto: SOLO en la primera tarea de la serie (1 badge por serie).
+        con_alerta = [t for t in target_tareas if t.get("alerta_reparto")]
