@@ -0,0 +1,170 @@
+"""
+CCa-17 — Sincronización unificada (universo + Cuadro OptiSteel). Pruebas con
+mocks de Cubigest y del scraper del Cuadro (sin tocar producción/ERP).
+
+Ejecutar: python -m unittest test_sync_unificado -v
+"""
+import asyncio
+import os
+import sqlite3
+import tempfile
+import unittest
+from unittest.mock import patch, MagicMock
+
+os.environ.setdefault("DB_PATH", os.path.join(tempfile.gettempdir(), "test_sync_unificado.db"))
+
+import routers.sync as sync_mod
+
+
+class TestSyncUnificado(unittest.TestCase):
+
+    def setUp(self):
+        self.db_path = tempfile.mktemp(suffix=".db")
+        sync_mod.DB_PATH = self.db_path
+        sync_mod._sync_lock = asyncio.Lock()
+
+    def tearDown(self):
+        if os.path.exists(self.db_path):
+            os.remove(self.db_path)
+
+    def _run(self, coro):
+        return asyncio.run(coro)
+
+    def _estado_rows(self):
+        with sqlite3.connect(self.db_path) as conn:
+            conn.row_factory = sqlite3.Row
+            return {(r["fuente"], r["sucursal_id"]): r for r in conn.execute("SELECT * FROM sync_estado")}
+
+    @patch("routers.sync.scrape_cuadro_programacion")
+    @patch("routers.sync._verificar_cubigest_vivo")
+    def test_exito_total_registra_ok_en_ambas_fuentes_y_3_sucursales(self, mock_verif, mock_scrape):
+        mock_verif.return_value = None
+        mock_scrape.return_value = {"ok": True, "registros": 10}
+
+        resultado = self._run(sync_mod.ejecutar_sync())
+
+        self.assertTrue(resultado["ok"])
+        self.assertEqual(len(resultado["resultados"]), 6)  # 3 sucursales x 2 fuentes
+        self.assertTrue(all(r["ok"] for r in resultado["resultados"]))
+        rows = self._estado_rows()
+        for suc in (1, 10, 14):
+            self.assertIsNotNone(rows[("universo", suc)]["ultimo_ok_ts"])
+            self.assertIsNotNone(rows[("cuadro", suc)]["ultimo_ok_ts"])
+        self.assertEqual(mock_scrape.call_count, 3)
+
+    @patch("routers.sync.scrape_cuadro_programacion")
+    @patch("routers.sync._verificar_cubigest_vivo")
+    def test_fallo_cuadro_conserva_datos_previos_y_marca_error_sin_tumbar_universo(self, mock_verif, mock_scrape):
+        mock_verif.return_value = None
+        # 1er sync: todo ok (deja un ultimo_ok_ts previo para "cuadro").
+        mock_scrape.return_value = {"ok": True, "registros": 5}
+        self._run(sync_mod.ejecutar_sync(sucursales=[1]))
+        rows_antes = self._estado_rows()
+        ok_previo_cuadro = rows_antes[("cuadro", 1)]["ultimo_ok_ts"]
+        self.assertIsNotNone(ok_previo_cuadro)
+
+        # 2do sync: el scraper del Cuadro falla (ej. 500 de Cubigest/SANTIAGO).
+        mock_scrape.side_effect = RuntimeError("Tabla Dtg_Lun no encontrada. HTTP 500.")
+        resultado = self._run(sync_mod.ejecutar_sync(sucursales=[1]))
+
+        self.assertFalse(resultado["ok"])
+        universo_r = next(r for r in resultado["resultados"] if r["fuente"] == "universo")
+        cuadro_r = next(r for r in resultado["resultados"] if r["fuente"] == "cuadro")
+        self.assertTrue(universo_r["ok"])   # el universo no se ve afectado por el fallo del Cuadro
+        self.assertFalse(cuadro_r["ok"])
+
+        rows_despues = self._estado_rows()
+        # ultimo_ok_ts del Cuadro NO se pisa con el fallo (queda el de la corrida anterior)
+        self.assertEqual(rows_despues[("cuadro", 1)]["ultimo_ok_ts"], ok_previo_cuadro)
+        self.assertIn("500", rows_despues[("cuadro", 1)]["ultimo_error_msg"])
+        self.assertIsNotNone(rows_despues[("cuadro", 1)]["ultimo_error_ts"])
+
+    @patch("routers.sync.scrape_cuadro_programacion")
+    @patch("routers.sync._verificar_cubigest_vivo")
+    def test_fallo_universo_cubigest_caido_no_bloquea_cuadro_y_registra_error(self, mock_verif, mock_scrape):
+        mock_verif.side_effect = RuntimeError("Cubigest no disponible (connect() devolvió None)")
+        mock_scrape.return_value = {"ok": True, "registros": 3}
+
+        resultado = self._run(sync_mod.ejecutar_sync(sucursales=[10]))
+
+        self.assertFalse(resultado["ok"])
+        universo_r = next(r for r in resultado["resultados"] if r["fuente"] == "universo")
+        cuadro_r = next(r for r in resultado["resultados"] if r["fuente"] == "cuadro")
+        self.assertFalse(universo_r["ok"])
+        self.assertTrue(cuadro_r["ok"])  # el Cuadro se sigue intentando aunque el universo falle
+        rows = self._estado_rows()
+        self.assertIsNone(rows[("universo", 10)]["ultimo_ok_ts"])
+        self.assertIsNotNone(rows[("universo", 10)]["ultimo_error_msg"])
+
+    @patch("routers.sync.scrape_cuadro_programacion")
+    @patch("routers.sync._verificar_cubigest_vivo")
+    def test_lock_concurrente_rechaza_segunda_ejecucion(self, mock_verif, mock_scrape):
+        mock_verif.return_value = None
+        mock_scrape.return_value = {"ok": True, "registros": 1}
+
+        async def _dos_en_paralelo():
+            return await asyncio.gather(
+                sync_mod.ejecutar_sync(sucursales=[1]),
+                sync_mod.ejecutar_sync(sucursales=[1]),
+                return_exceptions=True,
+            )
+
+        r1, r2 = self._run(_dos_en_paralelo())
+        resultados = [r1, r2]
+        errores_lock = [r for r in resultados if isinstance(r, RuntimeError)]
+        oks = [r for r in resultados if not isinstance(r, Exception)]
+        # Como ambas corren en el mismo loop sin await intermedio antes del
+        # chequeo de lock, una debe ganar el lock y la otra debe rechazarse.
+        self.assertEqual(len(errores_lock) + len(oks), 2)
+        self.assertGreaterEqual(len(errores_lock), 1)
+
+    @patch("routers.sync.scrape_cuadro_programacion")
+    @patch("routers.sync._verificar_cubigest_vivo")
+    def test_desactualizado_por_umbral(self, mock_verif, mock_scrape):
+        mock_verif.return_value = None
+        mock_scrape.return_value = {"ok": True, "registros": 1}
+        sync_mod.UMBRAL_DESACTUALIZADO_MIN = 90
+
+        # Sin ninguna corrida todavía: desactualizado=True (nunca hubo ok).
+        estado = self._run(sync_mod.sync_estado())
+        universo_calama = next(f for f in estado["fuentes"] if f["fuente"] == "universo" and f["sucursal_id"] == 1)
+        self.assertTrue(universo_calama["desactualizado"])
+        self.assertIsNone(universo_calama["minutos_desde_ok"])
+
+        # Forzar un ultimo_ok_ts viejo (hace 200 minutos) directo en la tabla.
+        sync_mod._init_tabla()
+        with sqlite3.connect(self.db_path) as conn:
+            conn.execute(
+                "INSERT INTO sync_estado (fuente, sucursal_id, ultimo_ok_ts) VALUES ('universo', 1, datetime('now', '-200 minutes'))"
+            )
+            conn.commit()
+        estado = self._run(sync_mod.sync_estado())
+        universo_calama = next(f for f in estado["fuentes"] if f["fuente"] == "universo" and f["sucursal_id"] == 1)
+        self.assertTrue(universo_calama["desactualizado"])
+        self.assertGreater(universo_calama["minutos_desde_ok"], 90)
+
+        # ultimo_ok_ts reciente -> no desactualizado.
+        with sqlite3.connect(self.db_path) as conn:
+            conn.execute(
+                "UPDATE sync_estado SET ultimo_ok_ts = datetime('now', '-5 minutes') WHERE fuente='universo' AND sucursal_id=1"
+            )
+            conn.commit()
+        estado = self._run(sync_mod.sync_estado())
+        universo_calama = next(f for f in estado["fuentes"] if f["fuente"] == "universo" and f["sucursal_id"] == 1)
+        self.assertFalse(universo_calama["desactualizado"])
+
+    def test_job_horario_apagado_no_registra_job(self):
+        """SYNC_HORARIO_ACTIVO=0 (default): el job no debe registrarse. Se
+        verifica la variable de entorno tal como la lee main.py, sin levantar
+        el lifespan completo (requiere Cubigest/SQLite reales)."""
+        with patch.dict(os.environ, {}, clear=False):
+            os.environ.pop("SYNC_HORARIO_ACTIVO", None)
+            self.assertEqual(os.getenv("SYNC_HORARIO_ACTIVO", "0"), "0")
+
+    def test_sucursal_id_invalido_lanza_value_error(self):
+        with self.assertRaises(ValueError):
+            self._run(sync_mod.ejecutar_sync(sucursales=[999]))
+
+
+if __name__ == "__main__":
+    unittest.main()
