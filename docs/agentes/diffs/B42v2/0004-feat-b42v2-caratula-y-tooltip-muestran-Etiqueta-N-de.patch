@@ -1790,16 +1814,20 @@ export default function GestorProgramacion({ sucursal, turnoGlobal = 'Día', ave
                                 <span className="font-semibold text-slate-200">{hoveredEvent.diametro}mm <span className="text-slate-400 ml-1">{hoveredEvent.calidad_acero}</span></span>
                             </div>
                             <div className="flex justify-between items-center">
-                                <span className="text-slate-500 w-20 shrink-0">Kilos:</span>
-                                <span className="font-semibold text-slate-200">{Math.round(hoveredEvent.kilos ?? 0).toLocaleString('es-CL')} kg</span>
+                                <span className="text-slate-500 w-20 shrink-0">Largo:</span>
+                                <span className="font-semibold text-slate-200">{hoveredEvent.largo_a != null ? `${hoveredEvent.largo_a} m` : '—'}</span>
+                            </div>
+                            <div className="flex justify-between items-center">
