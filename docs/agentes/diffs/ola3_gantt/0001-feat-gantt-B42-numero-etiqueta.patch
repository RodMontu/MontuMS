diff --git a/backend/database_cubigest.py b/backend/database_cubigest.py
index 1921c0a..3ae1b77 100644
--- a/backend/database_cubigest.py
+++ b/backend/database_cubigest.py
@@ -16,6 +16,24 @@ load_dotenv(_ENV_PATH)
 _cache_estado_maquinas: dict = {}
 _CACHE_TTL_MAQ = 900  # 15 min
 
+import re as _re_etiqueta
+_RE_NUMERO_ETIQUETA = _re_etiqueta.compile(r"Tag\s*#:\s*(\d+)\s*of\s*(\d+)", _re_etiqueta.IGNORECASE)
+
+
+def parse_numero_etiqueta(etiqueta_raw: str | None) -> int | None:
+    """
+    Extrae el numero fisico de etiqueta de fabricacion desde el campo de
+    texto libre dp.Etiqueta de Cubigest (formato observado: "Tag #: N of M").
+    N = numero de etiqueta dentro del TAG/viaje (lo que ve el operario en
+    planta); distinto de dp.id (PK interna, usada hasta ahora como
+    "etiqueta_id" — B42).
+    """
+    if not etiqueta_raw:
+        return None
+    m = _RE_NUMERO_ETIQUETA.search(str(etiqueta_raw))
+    return int(m.group(1)) if m else None
+
+
 class CubigestDB:
     _instance = None
 
@@ -171,7 +189,8 @@ class CubigestDB:
             v.Codigo                       AS codigo_viaje,
             dp.nropiezas                   AS nro_piezas,
             ROUND(dp.KgsPaquete, 1)        AS kilos,
-            p.IdForma                      AS id_forma
+            p.IdForma                      AS id_forma,
+            dp.Etiqueta                    AS etiqueta_raw
         FROM IT it
         JOIN Viaje v                    ON v.IdIt = it.Id
         JOIN detallePaquetesPieza dp    ON dp.IdViaje = v.Id
@@ -190,6 +209,7 @@ class CubigestDB:
                 "nro_piezas": row.get("nro_piezas"),
                 "kilos": float(row.get("kilos") or 0),
                 "id_forma": row.get("id_forma"),
+                "numero_etiqueta": parse_numero_etiqueta(row.get("etiqueta_raw")),
             }
             for row in rows
         ]
