+class TestB42v2K2Reparto(unittest.TestCase):
+    """K2 + decision de Montu (24-09, ~20:15): el reparto en paralelo queda
+    SOLO MANUAL (el Jefe de Planta arrastra las cajitas-etiqueta sobrantes
+    a otra maquina). El Motor YA NO auto-divide una serie larga en 2
+    bloques: calcula y muestra la alerta (informativa, con la maquina
+    sugerida), pero lo que no cabe en el turno cae a bolsa (turno_lleno),
+    igual que antes de K2. Escenario: serie "filler" (8 x 1000 kg, IdForma=2
+    Ø10mm -> PRIMA 3D) consume ~275 min de PRIMA 3D desde el inicio del
+    turno; serie "target" (12 x 1000 kg, mismo IdForma/diametro, viaje
+    distinto) queda con < 300 min libres, con duracion de serie completa
+    (~413 min) que excede ese remanente."""
+
+    def test_k2_serie_larga_NO_se_reparte_sola_cae_a_bolsa_con_alerta(self):
+        filler = [
+            _etiqueta(eid=9000 + i, kgs=1000.0, id_forma=2, diametro=10,
+                      codigo_viaje="K2-FILLER/1", n=i + 1, m=8)
+            for i in range(8)
+        ]
+        target = [
+            _etiqueta(eid=9100 + i, kgs=1000.0, id_forma=2, diametro=10,
+                      codigo_viaje="K2-TARGET/1", n=i + 1, m=12)
+            for i in range(12)
+        ]
+        resultado = _run(filler + target)
+        tareas = resultado["tareas"]
+        bolsa = resultado["bolsa_sin_asignar"]
+
+        target_ids = {e["etiqueta_id"] for e in target}
+        target_tareas = [t for t in tareas if t["etiqueta_id"] in target_ids]
+        target_bolsa = [b for b in bolsa if b["etiqueta_id"] in target_ids]
+
+        # Sin reparto automatico: la serie NO se divide sola. Las etiquetas
+        # que caben en PRIMA 3D quedan como tareas ahi; el resto cae a bolsa
+        # con motivo_key="turno_lleno" (para que el Jefe de Planta las arrastre
+        # a otra maquina manualmente). Ninguna se pierde: tareas+bolsa=12.
+        self.assertEqual(len(target_tareas) + len(target_bolsa), 12,
+                          f"se perdieron etiquetas: tareas={len(target_tareas)} bolsa={len(target_bolsa)}")
+        self.assertGreater(len(target_bolsa), 0, "se esperaba que algo NO cupiera y cayera a bolsa (sin auto-reparto)")
+        self.assertTrue(all(b.get("motivo_key") == "turno_lleno" for b in target_bolsa))
+
+        # Ninguna tarea de esta serie debe quedar marcada como repartida
+        # (ya no existe la accion de auto-dividir en 2 bloques/2 maquinas).
+        self.assertTrue(all(not t.get("serie_repartida") for t in target_tareas))
+        maquinas_target = {t["nombre_maquina"] for t in target_tareas}
+        self.assertEqual(maquinas_target, {"PRIMA 3D"}, f"sin auto-reparto, todo lo agendado queda en 1 sola maquina, hubo: {maquinas_target}")
+
+        # alerta_reparto: SOLO en la primera tarea/entrada de la serie (1 badge
+        # por serie), informativa, con la maquina sugerida -- para que el Jefe
+        # de Planta sepa a donde arrastrar manualmente.
+        con_alerta = [x for x in (target_tareas + target_bolsa) if x.get("alerta_reparto")]
+        self.assertEqual(len(con_alerta), 1, f"debia haber 1 sola alerta_reparto en la serie, hubo {len(con_alerta)}")
+        self.assertEqual(con_alerta[0]["alerta_reparto"]["nivel"], "dura")
+        self.assertTrue(con_alerta[0]["alerta_reparto"]["maquina_sugerida"], "debe sugerir alguna maquina alternativa")
+        self.assertEqual(con_alerta[0]["etiqueta_id"], 9100, "la alerta debe ir en la primera etiqueta de la serie")
+
+        # Orden preservado: sin intercalar, fecha_inicio creciente sigue el
+        # orden original de etiqueta_id dentro de la unica maquina usada.
+        ts_ordenadas = sorted(target_tareas, key=lambda t: t["fecha_inicio"])
+        ids_por_fecha = [t["etiqueta_id"] for t in ts_ordenadas]
+        self.assertEqual(ids_por_fecha, sorted(ids_por_fecha), f"orden alterado: {ids_por_fecha}")
+
+
