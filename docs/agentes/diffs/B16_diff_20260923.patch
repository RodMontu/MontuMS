+def _obtener_presencia_capacidad(
+    sucursal_id: int, fecha: str, turno_norm: str, conocimiento: ConocimientoMotor
+) -> dict | None:
+    """
+    B16 — helper COMPARTIDO entre POST /generar y el scheduler automático
+    (main.py::_ejecutar_generacion), mismos argumentos en ambos.
+    Retorna {"fuente": "geovictoria"|"turnos_programados",
+             "operadores": [{"username", "entrada": "HH:MM"|None, "salida": "HH:MM"|None}]}
+    o None si no se pudo determinar (nunca lanza — try/except interno, no invasivo AC8).
+    """
+    try:
+        from motor_v2 import SUCURSALES
+        sucursal_nombre = SUCURSALES.get(sucursal_id, "")
+
+        # Pool de operadores reales (matriz de competencias) — excluye ayudantes
+        # porque estos no tienen fila en operadores_matriz/operadores_x_maquina (R3).
+        todos: set[str] = set()
+        for (suc, _maq), ops in conocimiento.operadores_x_maquina.items():
+            if suc.lower() == sucursal_nombre.lower():
+                todos.update(ops)
+        if not todos:
+            return {"fuente": "turnos_programados" if fecha > date.today().isoformat() else "geovictoria",
+                    "operadores": []}
+
+        if fecha > date.today().isoformat():
+            # Día futuro: dotación planificada desde turnos_programados (R2: estado='PRESENTE').
+            with sqlite3.connect(DB_PATH, timeout=5) as _cn:
+                rows = _cn.execute(
+                    "SELECT nombre, hora_inicio_turno, hora_fin_turno, estado "
+                    "FROM turnos_programados WHERE sucursal_id=? AND fecha=?",
+                    (sucursal_id, fecha),
+                ).fetchall()
+            if turno_norm == "dia":
+                rows = [r for r in rows if (r[1] or "") < "18:00"]
+            else:
+                rows = [r for r in rows if (r[1] or "") >= "18:00"]
+
+            with sqlite3.connect(DB_PATH, timeout=5) as _cn2:
+                _cn2.row_factory = sqlite3.Row
+                nombre_a_username = {
+                    (r["Nombre"] or "").strip().lower(): r["Operador"]
+                    for r in _cn2.execute(
+                        'SELECT "Operador", "Nombre" FROM operadores_matriz WHERE sucursal_id=?',
+                        (sucursal_id,),
+                    )
+                    if r["Nombre"]
+                }
+
+            operadores_out = []
+            for nombre, h_ini, h_fin, estado in rows:
+                if estado != "PRESENTE":
+                    continue  # FALTA/VACACIONES/LICENCIA → 0, no entra (R2)
+                username = nombre_a_username.get((nombre or "").strip().lower())
+                if not username or username not in todos:
+                    continue  # no está en la matriz de operadores → no cuenta (R3)
+                operadores_out.append({"username": username, "entrada": h_ini, "salida": h_fin})
+            return {"fuente": "turnos_programados", "operadores": operadores_out}
+
+        # Hoy/pasado: marcas reales desde Geovictoria (mismo endpoint que
+        # _obtener_operadores_disponibles; ya filtrado por cargo Operador — R3).
+        r = httpx.get(
+            f"{GEOVICTORIA_URL}/asistencia/operadores_presentes/{sucursal_id}",
+            timeout=5.0,
+        )
+        if r.status_code != 200:
+            return None
+        presentes = r.json()
+        if not presentes:
+            return {"fuente": "geovictoria", "operadores": []}
+
+        _fecha_hoy = date.today().isoformat()
+        _fecha_gv = presentes[0].get("fecha_referencia") if presentes else None
+        if _fecha_gv and _fecha_gv != _fecha_hoy:
+            return None  # scraper no corrió aún — no inventar presencia (mismo criterio que B35)
+
+        presentes = [p for p in presentes if p.get("turno_inferido") in (turno_norm, None, "")]
+
+        import unicodedata
+
+        def _sin_acento(s: str) -> str:
+            return "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn")
+
+        def _username_desde_nombre(nombre_completo: str) -> str:
+            partes = nombre_completo.strip().split()
+            if len(partes) < 2:
+                return ""
+            return _sin_acento(partes[0][0]).lower() + _sin_acento(partes[-2]).lower()
+
+        operadores_out = []
+        for p in presentes:
+            nombre = p.get("nombre")
+            if not nombre:
+                continue
+            username = _username_desde_nombre(nombre)
+            if not username or username not in {op.lower() for op in todos}:
+                continue
+            operadores_out.append({
+                "username": username,
+                "entrada": p.get("hora_inicio_turno"),
+                "salida": p.get("hora_fin_turno"),
+            })
+        return {"fuente": "geovictoria", "operadores": operadores_out}
+
+    except Exception as e:
+        logger.warning(f"[B16] _obtener_presencia_capacidad: {e}")
+        return None
+
