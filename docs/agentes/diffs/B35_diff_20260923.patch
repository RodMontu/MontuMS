+def _resolver_ventana_override(sucursal_id: int, fecha: str, turno_norm: str) -> tuple:
+    """
+    B35 - UNICA fuente de la ventana (+15 min inicio / -15 min fin).
+    Prioridad 1: turnos_programados (SQLite). Prioridad 2: API Geovictoria.
+    Retorna (inicio_ov, fin_ov, fuente). Si no hay datos: (None, None, "jornada_config"),
+    y el Motor cae a la jornada configurada (_get_config_turno prioridades 2/3).
+    """
+    inicio_ov, fin_ov = _ventana_desde_turnos_programados(sucursal_id, fecha, turno_norm)
+    if inicio_ov:
+        return inicio_ov, fin_ov, "turnos_programados"
+    inicio_ov, fin_ov = _ventana_desde_geovictoria(sucursal_id, turno_norm)
+    if inicio_ov:
+        return inicio_ov, fin_ov, "geovictoria"
+    return None, None, "jornada_config"
+
+
+def _resolver_turno_gantt(sucursal_id: int, fecha: str, turno_norm: str) -> dict:
+    """
+    B35 - Turno YA resuelto, tal como lo usa el Motor: misma cadena de override
+    + la MISMA _get_config_turno / _ventana_turno de motor_v2 (la regla NO se reimplementa).
+    Lo consumen el GET de pantalla (metadata) y, via _resolver_ventana_override, POST /generar.
+    """
+    if turno_norm not in ("dia", "noche"):
+        raise ValueError(f"turno invalido: {turno_norm!r}")
+    inicio_ov, fin_ov, fuente = _resolver_ventana_override(sucursal_id, fecha, turno_norm)
+    config = _get_config_turno(turno_norm, fecha, sucursal_id, inicio_ov, fin_ov)
+    h_ini, h_fin, b_ini, b_fin = _ventana_turno(fecha, config)
+    return {
+        "sucursal_id":       sucursal_id,
+        "fecha":             fecha,
+        "turno":             turno_norm,
+        "hora_inicio_turno": h_ini.strftime("%H:%M"),
+        "hora_fin_turno":    h_fin.strftime("%H:%M"),
+        "break_inicio":      b_ini.strftime("%H:%M"),
+        "break_fin":         b_fin.strftime("%H:%M"),
+        "fuente":            fuente,
+    }
+
+
