     return h_ini, h_fin, brk_ini, brk_fin
 
 
+UMBRAL_AUSENCIA_PARCIAL_MIN = 30  # B16: desvío ≥ 30 min (entrada tarde o salida temprana) = ventana parcial
+
+
+def _solape_minutos(a_ini: datetime, a_fin: datetime, b_ini: datetime, b_fin: datetime) -> float:
+    """Minutos de solape entre dos intervalos [a_ini,a_fin) y [b_ini,b_fin)."""
+    ini = max(a_ini, b_ini)
+    fin = min(a_fin, b_fin)
+    return max(0.0, (fin - ini).total_seconds() / 60)
+
+
+def _calcular_capacidad_mh(
+    fecha: str,
+    hora_inicio: datetime,
+    hora_fin: datetime,
+    brk_ini: datetime,
+    brk_fin: datetime,
+    presencia_capacidad: dict = None,
+) -> Optional[dict]:
+    """
+    B16 — capacidad de planta por jornada (minutos-hombre).
+    presencia_capacidad: {"fuente": "geovictoria"|"turnos_programados",
+                           "operadores": [{"username", "entrada": "HH:MM"|None, "salida": "HH:MM"|None}]}
+    Retorna None si presencia_capacidad es None (no se pudo determinar presencia).
+    Retorna capacidad_mh=0 si la lista de operadores viene vacía (AC7).
+    """
+    if presencia_capacidad is None:
+        return None
+
+    dur_planta = (hora_fin - hora_inicio).total_seconds() / 60
+    solape_planta = _solape_minutos(hora_inicio, hora_fin, brk_ini, brk_fin)
+    min_utiles_planta = max(0.0, dur_planta - solape_planta)
+
+    base = datetime.strptime(fecha, "%Y-%m-%d")
+
+    def _anclar_persona(hm: str) -> datetime:
+        dt = datetime.strptime(hm, "%H:%M").replace(year=base.year, month=base.month, day=base.day)
+        if dt < hora_inicio - timedelta(hours=12):
+            dt += timedelta(days=1)
+        return dt
+
+    operadores = presencia_capacidad.get("operadores") or []
+    capacidad_mh = 0.0
+    operadores_parciales = []
+    vistos: set[str] = set()
+
+    for persona in operadores:
+        username = persona.get("username")
+        if not username or username in vistos:
+            continue  # AR-009: un operador cuenta una sola vez
+        vistos.add(username)
+
+        entrada_s = persona.get("entrada")
+        salida_s = persona.get("salida")
+        min_utiles = min_utiles_planta
+
+        if entrada_s and salida_s:
+            try:
+                ini_p = _anclar_persona(entrada_s)
+                fin_p = _anclar_persona(salida_s)
+                if fin_p <= ini_p:
+                    fin_p += timedelta(days=1)
+                desvio_entrada = max(0.0, (ini_p - hora_inicio).total_seconds() / 60)
+                desvio_salida = max(0.0, (hora_fin - fin_p).total_seconds() / 60)
+                if desvio_entrada >= UMBRAL_AUSENCIA_PARCIAL_MIN or desvio_salida >= UMBRAL_AUSENCIA_PARCIAL_MIN:
+                    ini_ef = max(ini_p, hora_inicio)
+                    fin_ef = min(fin_p, hora_fin)
+                    dur = max(0.0, (fin_ef - ini_ef).total_seconds() / 60)
+                    solape = _solape_minutos(ini_ef, fin_ef, brk_ini, brk_fin)
+                    min_utiles = max(0.0, dur - solape)
+                    operadores_parciales.append({
+                        "username": username,
+                        "min_utiles": round(min_utiles, 1),
+                    })
+            except ValueError:
+                min_utiles = min_utiles_planta
+
+        capacidad_mh += min_utiles
+
+    return {
+        "capacidad_mh": round(capacidad_mh, 1),
+        "operadores_contados": len(vistos),
+        "min_utiles_planta": round(min_utiles_planta, 1),
+        "operadores_parciales": operadores_parciales,
+        "fuente_presencia": presencia_capacidad.get("fuente"),
+    }
+
+
