+                                <span className="font-semibold text-slate-200">{hoveredEvent.id_forma ?? '—'}</span>
                             </div>
                             <div className="flex justify-between items-center">
-                                <span className="text-slate-500 w-20 shrink-0">PIEZAS:</span>
