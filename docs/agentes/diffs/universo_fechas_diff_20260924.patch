+"""
+universo_fechas.py — Clasificación única de fechas de despacho para el universo
+de compromisos (ITs pendientes). Reemplaza las ventanas -30d/+21d duplicadas en
+database_cubigest.py, materias_primas.py y programacion.py.
+
+Puro: sin acceso a BD, solo datetime.date/int. Ver
+/Users/montu/MontuMS/docs/agentes/UNIVERSO_FECHAS_spec.md (sección 3) para el
+acuerdo de umbrales con Montu (24-09-2026).
+"""
+from datetime import date
+
+UMBRAL_ATRASADA_SUCIEDAD_DIAS = 30
+UMBRAL_PROXIMA_DIAS = 21
+UMBRAL_LEJANA_DIAS = 60
+UMBRAL_HORIZONTE_SOSPECHOSO_DIAS = 120
+
+
+def clasificar_fecha(
+    fecha_despacho: date,
+    horizonte_reprog: int | None = None,
+    hoy: date | None = None,
+) -> str:
+    """Clasifica una fecha de despacho respecto de hoy.
+
+    Args:
+        fecha_despacho: fecha efectiva de despacho (FechaDespacho con
+            fallback FechaEntrega).
+        horizonte_reprog: días entre fecha de despacho y fecha de última
+            reprogramación (proxy de "espera de confirmación del cliente").
+            None si no se conoce.
+        hoy: fecha de referencia; por defecto date.today().
+
+    Returns:
+        Una de: "atrasada_valida", "atrasada_suciedad", "proxima",
+        "lejana_normal", "muy_futura".
+    """
+    if hoy is None:
+        hoy = date.today()
+
+    dias = (fecha_despacho - hoy).days
+
+    if dias < 0:
+        dias_atraso = -dias
+        if dias_atraso > UMBRAL_ATRASADA_SUCIEDAD_DIAS:
+            return "atrasada_suciedad"
+        return "atrasada_valida"
+
+    if dias <= UMBRAL_PROXIMA_DIAS:
+        return "proxima"
+
+    if dias > UMBRAL_LEJANA_DIAS:
+        return "muy_futura"
+
+    if (
+        horizonte_reprog is not None
+        and horizonte_reprog > UMBRAL_HORIZONTE_SOSPECHOSO_DIAS
+    ):
+        return "muy_futura"
+
+    return "lejana_normal"
