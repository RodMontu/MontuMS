+def _obtener_ajustes_duracion(sucursal_id: int, fecha: str, turno: str) -> dict:
+    """B44(a): mapa id_tarea -> minutos ajustados manualmente para (sucursal,fecha,turno)."""
+    turno_norm = str(turno).lower().replace("í", "i").replace("ó", "o")
+    try:
+        _init_programacion_guardada()
+        with sqlite3.connect(DB_PATH, timeout=5) as conn:
+            filas = conn.execute(
+                "SELECT id_tarea, minutos FROM ajustes_duracion WHERE sucursal_id=? AND fecha=? AND turno=?",
+                (sucursal_id, fecha, turno_norm),
+            ).fetchall()
+        return {f[0]: f[1] for f in filas}
+    except Exception as e:
+        logger.warning(f"[B44a] No se pudieron leer ajustes de duracion: {e}")
+        return {}
+
+
+def _aplicar_ajustes_duracion(items: list, sucursal_id: int, fecha: str, turno: str) -> None:
+    """
+    B44(a): sobreescribe fecha_fin/duracion_min de las tareas con ajuste manual
+    guardado. Solo afecta la cajita ajustada — fecha_inicio no se toca, por lo
+    que las cajitas siguientes de la misma maquina NO se recorren (supuesto
+    documentado en el informe: el hueco liberado queda vacio hasta el proximo
+    "Generar").
+    """
+    ajustes = _obtener_ajustes_duracion(sucursal_id, fecha, turno)
+    if not ajustes:
+        return
+    for it in items:
+        minutos = ajustes.get(it.get("id_tarea"))
+        if minutos is None or not it.get("fecha_inicio"):
+            continue
+        try:
+            inicio = datetime.fromisoformat(it["fecha_inicio"])
+            it["fecha_fin"] = (inicio + timedelta(minutes=minutos)).isoformat()
+            it["duracion_min"] = minutos
+            it["ajuste_manual"] = True
+        except Exception as e:
+            logger.warning(f"[B44a] No se pudo aplicar ajuste a {it.get('id_tarea')}: {e}")
+
+
 router = APIRouter(prefix="/api/programacion", tags=["programacion"])
